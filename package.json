{
  "name": "mapa-pesquisa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "data:validate": "node --import tsx ingest/validate.ts",
    "data:merge": "node --import tsx ingest/merge-research.ts"
  },
  "dependencies": {
    "@svg-maps/brazil": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
